# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================
# CONFIGURAÇÕES DE PRODUÇÃO PARA HOSPEDAGEM (HOSTINGER / CPANEL)
# =========================================================

# Ambiente de execução (production ou development)
NODE_ENV="production"

# Porta padrão do servidor Node.js
PORT="3000"

# Tipo de Banco de Dados: 'mysql' para MySQL/MariaDB ou 'json' para armazenamento local em arquivo
DB_TYPE="mysql"

# Host do Banco de Dados MySQL (na hospedagem é 'localhost' ou o IP fornecido no painel)
DB_HOST="localhost"

# Porta padrão do MySQL
DB_PORT="3306"

# Nome do Banco de Dados criado no painel da sua hospedagem
DB_NAME="u123456789_meudocelar"

# Usuário com permissões no Banco de Dados MySQL
DB_USER="u123456789_user"

# Senha do Usuário MySQL criada na hospedagem
DB_PASSWORD="SuaSenhaForteAqui123"

# Chave Secreta para Assinatura Criptográfica de Tokens Admin (JWT)
JWT_SECRET="chave_secreta_super_segura_meudocelar"

